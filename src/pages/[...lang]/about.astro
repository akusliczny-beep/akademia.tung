---
import { getLanguage, languagePaths, useTranslations } from "../../i18n";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getPersonalInfo } from "../../config";
export const getStaticPaths = languagePaths;
const lang = getLanguage(Astro.params.lang);
const t = useTranslations(lang);
const personalInfo = getPersonalInfo(lang);
const logoSrc = "/logo-system-tunga.png";
---

<BlogLayout
  title={t("about.heroTitle")}
  description={t("meta.aboutDescription")}
  heroTitle={t("about.heroTitle")}
  pageType="ProfilePage"
>
  <section class="card page-card about-card">
    <div class="about-intro">
      <img
        src={logoSrc}
        width="132"
        height="132"
        alt={`${personalInfo.name} — System Tunga`}
        loading="lazy"
        decoding="async"
      />
      <div>
        <h2>{t("about.greeting")}</h2>
        <p>{personalInfo.role}</p>
      </div>
    </div>

    <p class="about-blog">{t("about.blog")}</p>
  </section>
</BlogLayout>
<style>
  .about-intro {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .about-intro img {
    width: auto;
    max-width: 132px;
    max-height: 132px;
    height: auto;
    object-fit: contain;
    border-radius: 0;
  }
  .about-intro h2 {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.25;
    margin: 2px 0 4px;
  }
  .about-intro p {
    color: var(--accent);
    font-size: 15px;
    margin: 0;
  }
  .about-blog {
    font-size: 16px;
    line-height: 1.7;
    margin: 24px 0 0;
  }
  @media (max-width: 480px) {
    .about-intro {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
